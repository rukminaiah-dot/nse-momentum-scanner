{
  "expo": {
    "name": "NSE Momentum Scanner",
    "slug": "nse-momentum-scanner",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "nsemomentum",
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-asset",
      "expo-font"
    ],
    "android": {
      "package": "com.personal.nsemomentum",
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3083d1c9-4fe5-4ae9-be75-869319398af0"
      }
    },
    "web": {
      "output": "single"
    }
  }
}